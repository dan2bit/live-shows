# Python
__pycache__/
*.py[cod]
*.pyo
.venv/

# Credentials and secrets — never commit these
.env
client_secrets.json
token.json

# Private sidecar — NEVER belongs in this PUBLIC repo. Lives only in the separate
# dan2bit/live-shows-private repo. On 2026-06-27 an inbox routine wrote the private
# purchasing ledger here by path instead of to that repo; it leaked the
# full cost/seat/qty/notes data and required a history rewrite + force-push to purge.
# This block makes it un-stageable locally; a CI guard backstops it server-side.
live-shows-private/
*_private.tsv
fast_track_caps.tsv

# Google Drive stub files (macOS backup excludes these)
*.gdoc
*.gsheet
*.gslides
*.gdraw
*.gform
*.gmaps
*.gsite

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs
logs/*.log
logs/*.tsv

# Per-show upload manifests and their scan sidecars. Local working files, one set
# per show, carrying no private data — ignored to keep per-show churn out of the
# repo. Delete a manifest only when its clips are published; it holds the video
# IDs that let an interrupted upload resume.
tools/youtube/manifests/

# MCP change-sets: proposed-but-not-yet-applied channel edits, one JSON per
# proposal. Local working files with a one-day expiry; the audit trail worth
# keeping is the applied result on the channel itself.
tools/youtube/.changesets/

# Editor
.vscode/
.idea/
*.swp
*.swo
